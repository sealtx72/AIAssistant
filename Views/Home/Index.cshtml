@model AIAssistant.Models.Home
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h2 class="display-4 pt-5">Welcome to</h2>
    <h1 class="display-1">AI Assistant</h1>
    <p>Learn more about <a target="_blank" href="https://ai.google.dev/">AI Assistant</a>. Powered by Gemini 3 Flash, an AI assistant made by Google.</p>
    
    <form asp-action="Index" method="post" enctype="multipart/form-data">
        <p class="mt-5">What's' on your mind? </p>
        <input asp-for="Request" class="form-control" />
        <span asp-validation-for="Request" class="text-danger"></span>
        <div class="col-12 d-flex justify-content-end mt-2">
            <button type="submit" class="btn btn-primary" name="action" value="text">Enter</button>
        </div>
        @if(ViewBag.ValueMessageVisible == true)
            {
                <p class="mt-3">@ViewBag.ValueMessage</p>
            }
        <p class="mt-5">Or do you have a file you would like me to analize?</p>
        <div class="row">
            <div class="col-4"></div>
            <div class="col-4">
                <input type="file" asp-for="UploadedFile" class="form-control mb-2" />
                <div class="col-12 d-flex justify-content-center mt-2">
                    <button type="submit" class="btn btn-primary" name="action" value="upload">Upload</button>
                </div>
               @*  @if (ViewBag.ValueMessageVisible == true)
                {
                    <p class="mt-3">@ViewBag.ValueMessage</p>
                } *@
            </div>
            <div class="col-4"></div>
        </div>
    </form>
</div>
